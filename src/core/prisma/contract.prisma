// use prisma-next
//
// Ekoz reference server — Prisma Next data contract.
//
// This is NOT a classic `schema.prisma`: Prisma 8 ("Prisma Next") replaced the
// generator + `PrismaClient` with an emitted *contract* (`generated/contract.json`
// + `generated/contract.d.ts`, both committed) and a lightweight runtime client
// (`db.ts`). See the CHANGELOG entry for issue #2 and ADR 0002 (server stack).
//
// Conventions (task #2, item 7):
//   - models are PascalCase, tables/columns snake_case via `@@map` / `@map`;
//   - generated ids are ULID via `@default(ulid())` — 26-char Crockford base32,
//     dash-free; ms-prefix gives insert locality, NOT a reliable order
//     (that is the per-room `seq`, ADR 0004 / 0021);
//   - timestamps are `timestamptz`, carried as ISO-8601 strings;
//   - the connection URL lives only in the environment (infra `database.url`),
//     never here — migrations read it from `prisma.config.ts`, the runtime from
//     the `url` passed to `postgres()` in `db.ts`.
//
// Only the `Setting` model lands here: it is pure infrastructure (the admin
// override store for the layered configuration system) and gives the migration
// workflow and the integration tests a real table to exercise. The remaining
// server-core models (ServerSigningKey, SetupToken, Blob, EmailMessage,
// AuditLog — technical.md §11) are each introduced by their own task (#4, #5,
// #7, #8, #9, #10).

/// Layered configuration: admin overrides for `runtime` parameters only.
model Setting {
  key       String                     @id
  // `Jsonb` (not `Json`) → a `jsonb` column, per technical.md §11.
  value     Jsonb
  updatedAt temporal.updatedAtString() @map("updated_at")
  updatedBy String?                    @map("updated_by")

  @@map("settings")
}

/// Canonical server identity, single row (technical.md §4, ADR 0007). Written
/// once on the first boot that reaches identity setup; a later `server.domain`
/// change is refused at boot because it would break every `name/server`
/// identifier. `id` is the fixed sentinel `"server"`.
model ServerIdentity {
  id        String                     @id
  domain    String
  createdAt temporal.createdAtString() @map("created_at")

  @@map("server_identity")
}

/// Server signing keypair (technical.md §4, ADR 0006). Exactly one row is
/// active at a time (`activatedAt` set, `retiredAt` null); rotation retires the
/// previous key and a sweep drops keys past the overlap window. `id` is a short
/// random key id, not a ULID — it is published in the discovery document and
/// referenced by every signature. The private key is stored sealed by
/// `SecretBox` (AES-256-GCM under the infra `secret.key`).
model ServerSigningKey {
  id            String                     @id
  algorithm     String                     @default("ed25519")
  publicKey     String                     @map("public_key")
  privateKeyEnc Bytes                      @map("private_key_enc")
  createdAt     temporal.createdAtString() @map("created_at")
  activatedAt   TimestamptzString?         @map("activated_at")
  retiredAt     TimestamptzString?         @map("retired_at")

  @@index([activatedAt])
  @@map("server_signing_key")
}

/// Append-only audit trail (technical.md §8). Written through `AuditService`
/// only; there is no update/delete API. `actorUserId` null = system action.
model AuditLog {
  id          String                     @id @default(ulid())
  at          temporal.createdAtString()
  actorUserId String?                    @map("actor_user_id")
  actorIp     String?                    @map("actor_ip")
  action      String
  targetType  String?                    @map("target_type")
  targetId    String?                    @map("target_id")
  // `Jsonb` → a `jsonb` column; the service always supplies an object.
  metadata    Jsonb

  @@index([at])
  @@index([actorUserId])
  @@map("audit_log")
}
