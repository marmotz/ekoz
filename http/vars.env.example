# Hurl variables. Copy to `http/vars.env` (gitignored) and adjust.
# Usage: hurl --variables-file http/vars.env --test --glob 'http/**/*.hurl'

# Base URL of the running server (config.toml ships http.port = 3010).
base_url=http://localhost:3010

# A base64url single-use setup token, printed at WARN on every boot while setup
# is token-pinned (see http/setup/create-owner.hurl). Paste the current one here
# or pass it inline: --variable setup_token=...
setup_token=replace-me
