# Hurl variables. Copy to `http/vars.env` (gitignored) and adjust.
#
# These files are a hand-run collection to *exercise* the API, not an automated
# suite (that is `src/**/*.e2e-spec.ts`). Fixed values (passwords, names, emails)
# are baked into the files; only per-run secrets live here. Fill them as you go:
# run the request that mints a value, copy it in (or pass `--variable name=...`),
# then run the ones that need it.
#
# Every account created by the happy-path files uses the password
#   correct-horse-battery-staple
# and the owner login is identifier `owner`.

# Base URL of the running server (config.toml ships http.port = 3010).
base_url=http://localhost:3010

# Single-use setup token, printed at WARN on every boot while setup is
# token-pinned and open:
#   bun run start:dev 2>&1 | grep -A2 'single-use token'
setup_token=replace-me

# Bearer access token — from POST /auth/login or POST /setup/owner.
access_token=replace-me

# Opaque refresh token — from POST /auth/login or POST /setup/owner.
refresh_token=replace-me

# A session id — from GET /sessions or a login response.
session_id=replace-me

# Opaque invitation token and its id — from POST /invitations.
invite_token=replace-me
invitation_id=replace-me

# Email-verification token — from the `email-verification` mail (Mailpit UI on
# http://localhost:8025), the `?token=...` in the link.
verify_token=replace-me
