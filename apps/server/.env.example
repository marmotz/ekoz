# Copy to `.env` for local development. `.env` is gitignored.
# `compose.yaml` brings up PostgreSQL 18 on 5432 and Mailpit on 1025/8025.

# infra: database.url (PostgreSQL connection string).
# `config.toml` reads it as ${DATABASE_URL}.
DATABASE_URL="postgresql://ekoz:ekoz@localhost:5432/ekoz"

# All other parameters live in `config.toml` (layered configuration, ADR 0009).
# `config.toml` is the committed local-dev baseline; deployments ship their own.
# Point elsewhere with EKOZ_CONFIG_FILE, and override any single parameter with
# EKOZ_<SECTION>__<KEY> (e.g. EKOZ_HTTP__PORT=3001).
#EKOZ_CONFIG_FILE="./config.toml"

# Optional: pin the first-owner email (ADR 0010). When set, only this address
# can create the owner account and no setup token is printed. When unset, the
# server prints a single-use setup token to stdout on first start.
#EKOZ_INITIAL_OWNER_EMAIL="owner@example.com"

# Optional: origins allowed to call this API cross-origin (comma-separated).
# `config.toml`'s [http] section already ships the local-dev origins; override
# here for a different set. Empty / unset ⇒ CORS stays off.
#EKOZ_HTTP__CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
