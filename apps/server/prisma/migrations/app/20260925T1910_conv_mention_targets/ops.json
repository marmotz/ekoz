  {
    "id": "data.backfill-message-mention-targets",
    "label": "Backfill mention targets and recipients from message_mention",
    "operationClass": "data",
    "target": {
      "id": "postgres"
    },
    "precheck": [],
    "execute": [
      {
        "description": "Insert one user target per existing mention",
        "sql": "INSERT INTO \"public\".\"message_mention_target\" (\"message_id\", \"type\", \"target\", \"token\", \"position\")\nSELECT mm.\"message_id\", 'user', mm.\"user_id\",\n  CASE\n    WHEN u.\"id\" IS NULL OR u.\"status\"::text = 'deleted' OR u.\"name\" IS NULL OR si.\"domain\" IS NULL THEN '@deleted'\n    ELSE '@' || u.\"name\" || '/' || si.\"domain\"\n  END,\n  (row_number() OVER (PARTITION BY mm.\"message_id\" ORDER BY mm.\"user_id\") - 1)::int\nFROM \"public\".\"message_mention\" mm\nLEFT JOIN \"public\".\"user\" u ON u.\"id\" = mm.\"user_id\"\nLEFT JOIN \"public\".\"server_identity\" si ON si.\"id\" = 'server'\nON CONFLICT DO NOTHING",
        "params": []
      },
      {
        "description": "Insert one recipient per existing mention, at the message seq",
        "sql": "INSERT INTO \"public\".\"message_mention_recipient\" (\"message_id\", \"type\", \"target\", \"user_id\", \"room_id\", \"seq\")\nSELECT mm.\"message_id\", 'user', mm.\"user_id\", mm.\"user_id\", m.\"room_id\", m.\"seq\"\nFROM \"public\".\"message_mention\" mm\nJOIN \"public\".\"message\" m ON m.\"id\" = mm.\"message_id\"\nWHERE m.\"author_id\" IS DISTINCT FROM mm.\"user_id\"\nON CONFLICT DO NOTHING",
        "params": []
      }
    ],
    "postcheck": []
  },
