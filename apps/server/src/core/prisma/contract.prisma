// use prisma-next
//
// Ekoz reference server — Prisma Next data contract.
//
// This is NOT a classic `schema.prisma`: Prisma 8 ("Prisma Next") replaced the
// generator + `PrismaClient` with an emitted *contract* (`generated/contract.json`
// + `generated/contract.d.ts`, both committed) and a lightweight runtime client
// (`db.ts`). See the CHANGELOG entry for issue #2 and ADR 0002 (server stack).
//
// Conventions (task #2, item 7):
//   - models are PascalCase, tables/columns snake_case via `@@map` / `@map`;
//   - generated ids are ULID via `@default(ulid())` — 26-char Crockford base32,
//     dash-free; ms-prefix gives insert locality, NOT a reliable order
//     (that is the per-room `seq`, ADR 0004 / 0021);
//   - timestamps are `timestamptz`, carried as ISO-8601 strings;
//   - the connection URL lives only in the environment (infra `database.url`),
//     never here — migrations read it from `prisma.config.ts`, the runtime from
//     the `url` passed to `postgres()` in `db.ts`.
//
// Only the `Setting` model lands here: it is pure infrastructure (the admin
// override store for the layered configuration system) and gives the migration
// workflow and the integration tests a real table to exercise. The remaining
// server-core models (ServerSigningKey, SetupToken, Blob, EmailMessage,
// AuditLog — technical.md §11) are each introduced by their own task (#4, #5,
// #7, #8, #9, #10).

/// Layered configuration: admin overrides for `runtime` parameters only.
model Setting {
  key       String                     @id
  // `Jsonb` (not `Json`) → a `jsonb` column, per technical.md §11.
  value     Jsonb
  updatedAt temporal.updatedAtString() @map("updated_at")
  updatedBy String?                    @map("updated_by")

  @@map("settings")
}

/// Canonical server identity, single row (technical.md §4, ADR 0007). Written
/// once on the first boot that reaches identity setup; a later `server.domain`
/// change is refused at boot because it would break every `name/server`
/// identifier. `id` is the fixed sentinel `"server"`.
model ServerIdentity {
  id        String                     @id
  domain    String
  createdAt temporal.createdAtString() @map("created_at")

  @@map("server_identity")
}

/// Server signing keypair (technical.md §4, ADR 0006). Exactly one row is
/// active at a time (`activatedAt` set, `retiredAt` null); rotation retires the
/// previous key and a sweep drops keys past the overlap window. `id` is a short
/// random key id, not a ULID — it is published in the discovery document and
/// referenced by every signature. The private key is stored sealed by
/// `SecretBox` (AES-256-GCM under the infra `secret.key`).
model ServerSigningKey {
  id            String                     @id
  algorithm     String                     @default("ed25519")
  publicKey     String                     @map("public_key")
  privateKeyEnc Bytes                      @map("private_key_enc")
  createdAt     temporal.createdAtString() @map("created_at")
  activatedAt   TimestamptzString?         @map("activated_at")
  retiredAt     TimestamptzString?         @map("retired_at")

  @@index([activatedAt])
  @@map("server_signing_key")
}

/// Append-only audit trail (technical.md §8). Written through `AuditService`
/// only; there is no update/delete API. `actorUserId` null = system action.
model AuditLog {
  id          String                     @id @default(ulid())
  at          temporal.createdAtString()
  actorUserId String?                    @map("actor_user_id")
  actorIp     String?                    @map("actor_ip")
  action      String
  targetType  String?                    @map("target_type")
  targetId    String?                    @map("target_id")
  // `Jsonb` → a `jsonb` column; the service always supplies an object.
  metadata    Jsonb

  @@index([at])
  @@index([actorUserId])
  @@map("audit_log")
}

/// Single-use setup token (technical.md §5, ADR 0010). Present only on a
/// token-pinned first boot: the plaintext is printed to stdout once, the hash is
/// stored here. `consumedAt` is set when the first owner is created; the row is
/// kept for the audit trail. At most one row exists at a time.
model SetupToken {
  id         String                     @id @default(ulid())
  tokenHash  String                     @map("token_hash")
  createdAt  temporal.createdAtString() @map("created_at")
  consumedAt TimestamptzString?         @map("consumed_at")

  @@map("setup_token")
}

/// Content-addressed, deduplicated blob (technical.md §6, ADR 0011). One row per
/// distinct SHA-256; `refCount` tracks how many features reference it and the GC
/// sweep drops rows that stayed at zero past the grace period. `sizeBytes` is a
/// plain `int4` (2 GiB ceiling) — enough for the avatar consumer this increment
/// ships; message attachments revisit it with per-user quotas.
model Blob {
  id              String                     @id @default(ulid())
  hash            String                     @unique
  sizeBytes       BigInt                     @map("size_bytes")
  contentType     String                     @map("content_type")
  storageKey      String                     @map("storage_key")
  refCount        Int                        @default(0) @map("ref_count")
  uploaderId      String?                    @map("uploader_id")
  touchedAt       TimestamptzString          @map("touched_at")
  width           Int?
  height          Int?
  durationMs      Int?                       @map("duration_ms")
  thumbnailBlobId String?                    @map("thumbnail_blob_id")
  createdAt       temporal.createdAtString() @map("created_at")

  @@index([refCount])
  @@index([uploaderId])
  @@map("blob")
}

/// Owner-set storage quota override for one user (technical.md §S8). No row =
/// `uploads.default_quota_bytes`. `quotaBytes = null` means unlimited.
model StorageQuotaOverride {
  userId     String            @id @map("user_id")
  quotaBytes BigInt?           @map("quota_bytes")
  updatedAt  temporal.updatedAtString() @map("updated_at")

  @@map("storage_quota_override")
}

enum UploadState {
  @@type("pg/text@1")
  receiving = "receiving"
  ready     = "ready"
  failed    = "failed"
}

/// A resumable upload (technical.md §S4, tus 1.0). `blobId` is set once the
/// upload completes and is ingested; `failure` carries the error code when
/// `state = failed`. No cross-module FK on `userId` (same rule as `Blob.uploaderId`).
model Upload {
  id        String            @id @default(ulid())
  userId    String            @map("user_id")
  filename  String
  length    BigInt
  offset    BigInt            @default(0)
  state     UploadState       @default(receiving)
  blobId    String?           @map("blob_id")
  failure   String?
  expiresAt TimestamptzString @map("expires_at")
  createdAt temporal.createdAtString() @map("created_at")

  @@index([userId, state])
  @@index([expiresAt])
  @@map("upload")
}

/// Outbound email record (technical.md §7). Written before the send attempt;
/// `sentAt` is stamped on success. `dedupeKey` (when supplied) is unique and
/// backs the coarse anti-duplication guard until the notifications feature owns
/// real rate limiting.
model EmailMessage {
  id        String                     @id @default(ulid())
  to        String
  template  String
  category  String
  dedupeKey String?                    @unique @map("dedupe_key")
  sentAt    TimestamptzString?         @map("sent_at")
  createdAt temporal.createdAtString() @map("created_at")

  @@map("email_message")
}

// ── identity: accounts, sessions ─────────────────────────────────────────────
// Feature `identity-and-profiles` (technical.md §4), ADR 0007 / 0008. Only the
// slice needed by issues #12–#14 lands here; registration, invitations, email
// verification, password reset, profiles and the username-change machinery each
// add their own models on their own task.

/// Account lifecycle (technical.md §4). `suspended` blocks all access but keeps
/// the identifier held; `deleted` frees `name` / `email` (nulled) and is
/// terminal.
enum UserStatus {
  @@type("pg/text@1")
  active    = "active"
  suspended = "suspended"
  deleted   = "deleted"
}

/// A local account (technical.md §4-§6, ADR 0007). `name` is the normalised
/// identifier (lowercase, NFC, `[a-z0-9_.-]`, 1-64) presented to the API as the
/// full `name/server`; both `name` and `email` are nulled on deletion so the
/// unique indexes free up. `email` is stored already lower-cased (the account
/// layer normalises it before insert). `passwordHash` is an Argon2id PHC string.
model User {
  id              String                     @id @default(ulid())
  name            String?                    @unique
  email           String?                    @unique
  emailVerifiedAt TimestamptzString?         @map("email_verified_at")
  passwordHash    String                     @map("password_hash")
  isOwner         Boolean                    @default(false) @map("is_owner")
  status          UserStatus                 @default(active)
  suspendedAt     TimestamptzString?         @map("suspended_at")
  suspendedReason String?                    @map("suspended_reason")
  deletedAt       TimestamptzString?         @map("deleted_at")
  createdAt       temporal.createdAtString() @map("created_at")
  updatedAt       temporal.updatedAtString() @map("updated_at")

  @@map("user")
}

/// Public-facing profile, one row per {@link User} (technical.md §4, §13).
/// `avatarBlobId` references a server-core `Blob` by id (no cross-module FK — the
/// avatar consumer manages `retain` / `release`). Created alongside the `User`.
model UserProfile {
  userId       String                     @id @map("user_id")
  displayName  String                     @map("display_name")
  bio          String?
  avatarBlobId String?                    @map("avatar_blob_id")
  updatedAt    temporal.updatedAtString() @map("updated_at")
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

/// A device-scoped login (technical.md §7, §11, ADR 0008). `revokedAt` set =
/// every access token carrying this `sid` is rejected (via the in-memory
/// denylist) and its refresh tokens are dead.
model Session {
  id            String                     @id @default(ulid())
  userId        String                     @map("user_id")
  deviceName    String                     @map("device_name")
  userAgent     String?                    @map("user_agent")
  ip            String?
  createdAt     temporal.createdAtString() @map("created_at")
  lastSeenAt    TimestamptzString          @map("last_seen_at")
  revokedAt     TimestamptzString?         @map("revoked_at")
  revokedReason String?                    @map("revoked_reason")
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// A single rotating opaque refresh token (technical.md §7, ADR 0008). Only the
/// SHA-256 hash is stored; `usedAt` set on rotation, and a second use of the
/// same hash trips reuse detection (whole session revoked).
model RefreshToken {
  id           String                     @id @default(ulid())
  sessionId    String                     @map("session_id")
  tokenHash    String                     @unique @map("token_hash")
  createdAt    temporal.createdAtString() @map("created_at")
  expiresAt    TimestamptzString          @map("expires_at")
  usedAt       TimestamptzString?         @map("used_at")
  replacedById String?                    @map("replaced_by_id")
  session      Session                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_token")
}

/// A `name` that is temporarily not assignable (technical.md §4-§5). Written
/// when an account is deleted or an identifier is changed; the availability
/// check rejects any `name` whose row has `reservedUntil > now()`.
model ReservedUsername {
  name          String                     @id
  reservedUntil TimestamptzString          @map("reserved_until")
  reason        String
  createdAt     temporal.createdAtString() @map("created_at")

  @@index([reservedUntil])
  @@map("reserved_username")
}

/// A registration invitation (technical.md §4, §8, issue #15). Only the SHA-256
/// hash of the opaque token is stored. `email` null = the link works for any
/// address; when set, registration must present a matching email. `consumedAt`
/// is stamped both on a successful registration and on an owner revocation
/// (`consumedByUserId` null in the revoked case).
model Invitation {
  id               String                     @id @default(ulid())
  email            String?
  tokenHash        String                     @unique @map("token_hash")
  createdByUserId  String                     @map("created_by_user_id")
  createdAt        temporal.createdAtString() @map("created_at")
  expiresAt        TimestamptzString          @map("expires_at")
  consumedAt       TimestamptzString?         @map("consumed_at")
  consumedByUserId String?                    @map("consumed_by_user_id")
  createdBy        User                       @relation(fields: [createdByUserId], references: [id])

  @@index([createdByUserId])
  @@map("invitation")
}

/// A pending email-address verification (technical.md §4, §9, issue #16). Used
/// both for the initial verification after registration and for an email change
/// (`email` is then the new address, applied to `User.email` only on consume).
/// Only the SHA-256 hash of the opaque token is stored.
model EmailVerification {
  id         String                     @id @default(ulid())
  userId     String                     @map("user_id")
  email      String
  tokenHash  String                     @unique @map("token_hash")
  createdAt  temporal.createdAtString() @map("created_at")
  expiresAt  TimestamptzString          @map("expires_at")
  consumedAt TimestamptzString?         @map("consumed_at")

  @@index([userId])
  @@map("email_verification")
}

/// A pending password reset (technical.md §4, §10, issue #17). TTL 1h
/// (`auth.password_reset_ttl`). Only the SHA-256 hash of the opaque token is
/// stored; `consumedAt` is stamped once the new password is set.
model PasswordReset {
  id          String                     @id @default(ulid())
  userId      String                     @map("user_id")
  tokenHash   String                     @unique @map("token_hash")
  requestedIp String?                    @map("requested_ip")
  createdAt   temporal.createdAtString() @map("created_at")
  expiresAt   TimestamptzString          @map("expires_at")
  consumedAt  TimestamptzString?         @map("consumed_at")

  @@index([userId])
  @@map("password_reset")
}

/// Lifecycle of an `approval`-mode identifier change (technical.md §4, §17,
/// issue #20). `available`-mode changes apply immediately and never create a
/// row; only the queued-for-owner path does.
enum UsernameChangeStatus {
  @@type("pg/text@1")
  pending   = "pending"
  approved  = "approved"
  rejected  = "rejected"
  cancelled = "cancelled"
}

/// A queued identifier change awaiting an owner decision (technical.md §17,
/// issue #20).
model UsernameChangeRequest {
  id               String                     @id @default(ulid())
  userId           String                     @map("user_id")
  requestedName    String                     @map("requested_name")
  status           UsernameChangeStatus       @default(pending)
  createdAt        temporal.createdAtString() @map("created_at")
  resolvedAt       TimestamptzString?         @map("resolved_at")
  resolvedByUserId String?                    @map("resolved_by_user_id")

  @@index([status])
  @@map("username_change_request")
}

// ── conversations: room hierarchy, event log, capability ACL ────────────────
// Feature `conversations` (technical.md §4-§10). Issue #1 (room model and
// hierarchy), #2 (per-room event log and seq allocation), #3 (capability ACL
// and resolver). Membership, invitations, messages, reactions, receipts,
// presence and retention each add their own models on their own issue (#4-#13)
// — this slice ships only what those three issues need. No FK to `User`: the
// identity feature owns that table (same cross-feature-FK avoidance as
// `UserProfile.avatarBlobId` above).

enum RoomType {
  @@type("pg/text@1")
  space    = "space"
  channel  = "channel"
  dm       = "dm"
  group_dm = "group_dm"
}

enum RoomVisibility {
  @@type("pg/text@1")
  public  = "public"
  private = "private"
  invite  = "invite"
}

/// Named role a member holds on a room or space (permission-model.md). `owner`
/// (server-level, implicit allow-all) is not a member of this set — it is the
/// `User.isOwner` flag, checked before any role resolution.
enum RoomRole {
  @@type("pg/text@1")
  space_admin = "space_admin"
  room_admin  = "room_admin"
  moderator   = "moderator"
  member      = "member"
  reader      = "reader"
}

/// An explicit allow/deny decision in an ACL override row (permission-model.md).
enum OverrideEffect {
  @@type("pg/text@1")
  allow = "allow"
  deny  = "deny"
}

/// Hierarchy node or conversation (technical.md §4-§5, §7, conversation-data-model.md).
/// `space` holds no message; `channel` is attached to a space; `dm` / `group_dm`
/// sit outside the hierarchy (`parentId = null`) and never appear in
/// `RoomClosure` beyond their self row. `lastSeq` is the per-room event `seq`
/// allocator, advanced under a row lock (technical.md §10, event-log-and-ordering.md).
model Room {
  id           String             @id @default(ulid())
  type         RoomType
  parentId     String?            @map("parent_id")
  visibility   RoomVisibility     @default(private)
  slug         String?
  name         String?
  topic        String?
  avatarBlobId String?            @map("avatar_blob_id")
  defaultRole  RoomRole           @default(member) @map("default_role")
  readOnly     Boolean            @default(false) @map("read_only")
  originServer String             @map("origin_server")
  lastSeq      BigInt             @default(0) @map("last_seq")
  // `Jsonb` (not `Json`) → a `jsonb` column, per technical.md §3. Shape:
  // `{ mode: "inherit" | "keep" }` | `{ mode: "hide" | "delete", after: "<duration>" }`
  // (retention.md); the retention feature (#12) reads/writes it, this slice
  // only carries the column with an application-level `{ mode: "inherit" }` default.
  retention    Jsonb
  dmKey        String?            @unique @map("dm_key")
  createdById  String?            @map("created_by_id")
  createdAt    temporal.createdAtString() @map("created_at")
  updatedAt    temporal.updatedAtString() @map("updated_at")
  deletedAt    TimestamptzString? @map("deleted_at")

  parent   Room?  @relation("room_children", fields: [parentId], references: [id])
  children Room[] @relation("room_children")

  @@index([parentId])
  @@index([type, visibility])
  // Public-directory full-text search (technical.md §8, issue #6): GIN index
  // over the `simple`-config tsvector of `name` + `topic`.
  @@index(
    expression: "to_tsvector('simple', coalesce(name, '') || ' ' || coalesce(topic, ''))",
    type: "gin",
    name: "room_directory_fts"
  )
  @@map("room")
}

/// Ancestor/descendant closure for `Room.parentId`, including the self row
/// (`depth = 0`) — one indexed query for both the ancestor chain (permission
/// resolution) and subtree checks (move / delete), per technical.md §5.
model RoomClosure {
  ancestorId   String @map("ancestor_id")
  descendantId String @map("descendant_id")
  depth        Int

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("room_closure")
}

/// Every `RoomEventType` this increment's issues emit or reserve
/// (technical.md §4). Only `room_*` events are actually written by #1-#3; the
/// rest are reserved for the issues that own that behaviour (#4, #7-#13) so the
/// enum does not grow non-additively later (permission-model.md: "the list is
/// part of the protocol and grows only additively").
enum RoomEventType {
  @@type("pg/text@1")
  message_created           = "message_created"
  message_edited            = "message_edited"
  message_redacted          = "message_redacted"
  message_deleted           = "message_deleted"
  message_hidden            = "message_hidden"
  reaction_added            = "reaction_added"
  reaction_removed          = "reaction_removed"
  member_joined             = "member_joined"
  member_left               = "member_left"
  member_kicked             = "member_kicked"
  member_banned             = "member_banned"
  member_unbanned           = "member_unbanned"
  role_changed              = "role_changed"
  permission_override_changed = "permission_override_changed"
  room_created              = "room_created"
  room_updated              = "room_updated"
  room_moved                = "room_moved"
  room_deleted              = "room_deleted"
  pin_added                 = "pin_added"
  pin_removed               = "pin_removed"
  retention_changed         = "retention_changed"
  receipt_updated           = "receipt_updated"
  group_changed             = "group_changed"
}

/// Append-only per-room event log (technical.md §10, event-log-and-ordering.md).
/// `seq` is allocated by `EventLogService.append` via
/// `UPDATE room SET last_seq = last_seq + 1 WHERE id = $1 RETURNING last_seq`
/// inside the caller's transaction — never assigned here. `originServer` is
/// `server.domain` now, same as `Room.originServer`; it becomes meaningful
/// with federation, where a remote-authored event carries its home server's
/// domain instead (technical.md §10).
model RoomEvent {
  roomId       String        @map("room_id")
  seq          BigInt
  type         RoomEventType
  senderId     String?       @map("sender_id")
  content      Jsonb
  originServer String        @map("origin_server")
  createdAt    temporal.createdAtString() @map("created_at")

  @@id([roomId, seq])
  @@index([roomId, createdAt])
  @@map("room_event")
}

/// Server-wide default capability grant/denial per role (permission-model.md),
/// seeded from the technical.md §6 matrix. Editable by an owner later; fixed
/// for this increment.
model RoleDefaultCapability {
  role       RoomRole
  capability String
  effect     OverrideEffect

  @@id([role, capability])
  @@map("role_default_capability")
}

/// A role-scoped ACL override on a space or room node, inherited by descendants
/// (permission-model.md). `nodeId` references a {@link Room}; no FK — the
/// resolver walks the closure table, not a join on this table.
model RoomPermissionOverride {
  id         String         @id @default(ulid())
  nodeId     String         @map("node_id")
  role       RoomRole
  capability String
  effect     OverrideEffect

  @@unique([nodeId, role, capability])
  @@index([nodeId])
  @@map("room_permission_override")
}

/// A per-user ACL override on a space or room node, inherited by descendants
/// (permission-model.md). Beats a same-node `RoomPermissionOverride` at equal
/// depth (per-user wins over per-role).
model RoomMemberPermission {
  id         String         @id @default(ulid())
  nodeId     String         @map("node_id")
  userId     String         @map("user_id")
  capability String
  effect     OverrideEffect

  @@unique([nodeId, userId, capability])
  @@index([nodeId])
  @@map("room_member_permission")
}

// ── conversations: membership lifecycle ─────────────────────────────────────
// Issue #4 (technical.md §9). Join/leave, invitations, invite-only join
// requests, kick, ban/unban. No FK to `User` (same cross-feature-FK avoidance
// as the rest of this feature).

/// Explicit membership of a user on a room or space (technical.md §4, §6, §9).
/// `PermissionsService` reads this — directly on the room, or inherited from
/// the nearest ancestor space membership via `RoomClosure` — to resolve the
/// caller's effective role.
model Membership {
  roomId      String                     @map("room_id")
  userId      String                     @map("user_id")
  role        RoomRole
  joinedAt    temporal.createdAtString() @map("joined_at")
  invitedById String?                    @map("invited_by_id")
  // Per-user hide/archive for a `dm` (technical.md §7, issue #5): hiding does
  // not remove the membership, only channels/spaces/group_dm use real leave.
  hiddenAt    TimestamptzString?         @map("hidden_at")
  // Per-member history floor: the member reads only messages with
  // `seq >= historyFromSeq`. `null` = full history (technical design S1 of
  // web-client-direct-messages).
  historyFromSeq BigInt?                 @map("history_from_seq")

  @@id([roomId, userId])
  @@index([userId])
  @@map("membership")
}

/// A standing invitation to join a room (technical.md §9). Only the invitee
/// may accept/decline; `acceptedAt` / `declinedAt` are mutually exclusive
/// terminal states, both null while pending.
model RoomInvitation {
  id          String                     @id @default(ulid())
  roomId      String                     @map("room_id")
  userId      String                     @map("user_id")
  invitedById String                     @map("invited_by_id")
  role        RoomRole                   @default(member)
  createdAt   temporal.createdAtString() @map("created_at")
  expiresAt   TimestamptzString?         @map("expires_at")
  acceptedAt  TimestamptzString?         @map("accepted_at")
  declinedAt  TimestamptzString?         @map("declined_at")

  @@unique([roomId, userId])
  @@map("room_invitation")
}

/// A request to join an invite-only room, awaiting a member with
/// `room.manage_members` (technical.md §9). `approved` is null while pending,
/// `true`/`false` once resolved.
model RoomJoinRequest {
  id           String                     @id @default(ulid())
  roomId       String                     @map("room_id")
  userId       String                     @map("user_id")
  createdAt    temporal.createdAtString() @map("created_at")
  resolvedAt   TimestamptzString?         @map("resolved_at")
  resolvedById String?                    @map("resolved_by_id")
  approved     Boolean?

  @@unique([roomId, userId])
  @@map("room_join_request")
}

/// A standing ban blocking `userId` from (re)joining `roomId` (technical.md
/// §9). Presence of a row is the ban; unban deletes it.
model RoomBan {
  roomId     String                     @map("room_id")
  userId     String                     @map("user_id")
  reason     String?
  bannedById String                     @map("banned_by_id")
  bannedAt   temporal.createdAtString() @map("banned_at")

  @@id([roomId, userId])
  @@map("room_ban")
}

// ── conversations: room groups ───────────────────────────────────────────────
// web-client-mentions technical.md S1 / S4. No FK to `User` or `Room`.

/// A named set of members defined on a room or space, mentionable as
/// `@<name>`. Names are unique over the whole ancestor/descendant chain of the
/// node (enforced by `GroupsService`, not by this per-node key).
model RoomGroup {
  id          String                     @id @default(ulid())
  nodeId      String                     @map("node_id")
  name        String
  createdById String                     @map("created_by_id")
  createdAt   temporal.createdAtString() @map("created_at")

  @@unique([nodeId, name])
  @@index([nodeId])
  @@map("room_group")
}

/// A member of a {@link RoomGroup}.
model RoomGroupMember {
  groupId String                     @map("group_id")
  userId  String                     @map("user_id")
  addedAt temporal.createdAtString() @map("added_at")

  @@id([groupId, userId])
  @@index([userId])
  @@map("room_group_member")
}

// ── conversations: messages ──────────────────────────────────────────────────
// Issue #7 (technical.md §11), plus the edit/delete/tombstone/retention
// columns (`editedAt`, `redactedAt`, `redactedById`, `hiddenAt`) owned by
// issues #8 and #12 — carried here now so `Message` only gains one shape once
// (same pattern as `Room.retention`). No FK to `User`.

/// A room message (technical.md §11-§12). `seq` equals the `seq` of its
/// `message_created` room_event, allocated in the same transaction
/// (event-log-and-ordering.md). `body` is the restricted-Markdown source.
model Message {
  id           String                     @id @default(ulid())
  roomId       String                     @map("room_id")
  seq          BigInt
  authorId     String?                    @map("author_id")
  body         String
  replyToId    String?                    @map("reply_to_id")
  editedAt     TimestamptzString?         @map("edited_at")
  redactedAt   TimestamptzString?         @map("redacted_at")
  redactedById String?                    @map("redacted_by_id")
  hiddenAt     TimestamptzString?         @map("hidden_at")
  createdAt    temporal.createdAtString() @map("created_at")

  @@unique([roomId, seq])
  @@index([roomId, createdAt])
  @@index([replyToId])
  @@map("message")
}

/// What the author of a {@link Message} mentioned (web-client-mentions technical.md
/// S1). `type` is `user`, `all`, `role` or `group`; `target` is the userId, role
/// name or groupId, "" for `all`. `token` is the literal body text standing for
/// the target, frozen when the target is created; `position` is the order of
/// first use, for a stable wire order.
model MessageMentionTarget {
  messageId String @map("message_id")
  type      String
  target    String
  token     String
  position  Int

  @@id([messageId, type, target])
  @@map("message_mention_target")
}

/// Who a {@link Message} concerns, resolved from its targets when a target is
/// created, then frozen. `seq` is the seq of the event that created the target:
/// the message's own for targets present at send time, the `message_edited`
/// event's for targets added by an edit.
model MessageMentionRecipient {
  messageId String @map("message_id")
  type      String
  target    String
  userId    String @map("user_id")
  roomId    String @map("room_id")
  seq       BigInt

  @@id([messageId, type, target, userId])
  @@index([userId, roomId, seq])
  @@index([messageId])
  @@map("message_mention_recipient")
}

/// A pinned message in a room (technical.md §11).
model MessagePin {
  roomId     String                     @map("room_id")
  messageId  String                     @map("message_id")
  pinnedById String                     @map("pinned_by_id")
  pinnedAt   temporal.createdAtString() @map("pinned_at")

  @@id([roomId, messageId])
  @@map("message_pin")
}

// ── conversations: reactions and read markers ────────────────────────────────
// Issue #9 (technical.md §11, §14).

/// A single-emoji reaction on a message (technical.md §11).
model Reaction {
  messageId String                     @map("message_id")
  userId    String                     @map("user_id")
  emoji     String
  createdAt temporal.createdAtString() @map("created_at")

  @@id([messageId, userId, emoji])
  @@index([messageId])
  @@map("reaction")
}

/// "Read up to `seq`" per (room, user) (technical.md §14). `seq` is monotonic
/// — a lower value is ignored, never applied.
model ReadMarker {
  roomId    String                     @map("room_id")
  userId    String                     @map("user_id")
  seq       BigInt
  updatedAt temporal.updatedAtString() @map("updated_at")

  @@id([roomId, userId])
  @@map("read_marker")
}

// ── conversations: presence preferences ──────────────────────────────────────
// Presence itself is ephemeral (technical.md §15); only the manual "appear
// away" choice is persisted, so it survives a new login. No FK to `User`, same
// cross-feature rule as `Membership`.

/// Per-user presence preference: `manualAway` forces the derived status to
/// `away` while the user has a live client. No row = `manualAway: false`.
model PresencePreference {
  userId     String                     @id @map("user_id")
  manualAway Boolean                    @default(false) @map("manual_away")
  updatedAt  temporal.updatedAtString() @map("updated_at")

  @@map("presence_preference")
}

// ── conversations: sync, account feed, SSE stream ────────────────────────────
// Issue #11 (technical.md §16). `feedSeq` is a single server-wide sequence
// (not reset per user) — simpler than a per-user cursor row and still
// monotonic for any one user's subset, which is all `Last-Event-ID` needs.

/// Per-account fan-in projection (technical.md §16): one row per event a user
/// should see on their live feed, independent of which room it came from.
/// `kind = "room_event"` mirrors a `RoomEvent` (`roomId` / `roomSeq` point back
/// to it); `kind = "account"` is account-scoped (invitations, join-request
/// outcomes, ...) and carries `roomId` for context only.
model AccountFeedEvent {
  userId    String                     @map("user_id")
  feedSeq   BigInt                     @default(autoincrement()) @map("feed_seq")
  roomId    String                     @map("room_id")
  roomSeq   BigInt?                    @map("room_seq")
  kind      String
  payload   Jsonb
  createdAt temporal.createdAtString() @map("created_at")

  @@id([userId, feedSeq])
  @@index([userId, createdAt])
  @@map("account_feed_event")
}

