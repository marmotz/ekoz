# Copy to `.env` for local development. `.env` is gitignored.
# `compose.yaml` brings up PostgreSQL 18 on 5432 and Mailpit on 1025/8025.

# infra: database.url (PostgreSQL connection string)
# Host port 5410 comes from compose.override.yaml.
DATABASE_URL="postgresql://ekoz:ekoz@localhost:5410/ekoz"

# infra: http.host / http.port (temporary env stopgap until the config task #4)
HTTP_HOST="0.0.0.0"
HTTP_PORT="3000"
