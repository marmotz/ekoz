{
  "name": "@ekoz-chat/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:contract": "prisma contract emit",
    "db:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:deploy": "prisma db migrate --no-interactive",
    "db:status": "prisma migration status",
    "db:verify": "prisma db verify",
    "postinstall": "prisma contract emit && prisma skills sync"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/cli-engine": "0.3.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "dotenv": "17.4.2",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "prisma": "8.0.0-rc.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "smol-toml": "^1.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.9.1",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.11.0",
    "lefthook": "^2.1.12",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "trustedDependencies": [
    "@swc/core",
    "protobufjs"
  ]
}
