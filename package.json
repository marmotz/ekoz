{
  "name": "@ekozhq/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "reset": "bun clean && bun i",
    "clean": "rm -rf node_modules dist && bun --workspaces clean",
    "build": "bun run --filter '@ekozhq/sdk' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "vitest run",
    "test:server": "bun run --filter '@ekozhq/server' test",
    "openapi:emit": "bun run --filter '@ekozhq/server' openapi:emit",
    "openapi:check": "bun run openapi:emit && git diff --exit-code apps/server/openapi.json",
    "generate": "bunx tako generate",
    "check": "bunx tako check",
    "lint": "biome check .",
    "lint:boundaries": "bun run --filter '@ekozhq/server' lint:boundaries && bun run --filter '@ekozhq/admin' lint:boundaries && bun run --filter '@ekozhq/client-web' lint:boundaries",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "release": "bash scripts/release-publish.sh",
    "release:version": "changeset version && bun run --filter '@ekozhq/docs' version-docs",
    "docs:version": "bun run --filter '@ekozhq/docs' version-docs",
    "update:minor": "bun x npm-check-updates -i -t minor -ws",
    "update:latest": "bun x npm-check-updates -i -t latest -ws",
    "wa": "bun --cwd=apps/admin",
    "wc": "bun --cwd=apps/client-web",
    "ws": "bun --cwd=apps/server",
    "wk": "bun --cwd=packages/sdk"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@kurotako/config": "^0.2.0",
    "@kurotako/core": "^0.3.0",
    "@kurotako/gen-react-tanstack": "^0.1.0",
    "@kurotako/gen-typescript": "^0.4.0",
    "@kurotako/gen-zod": "^0.4.0",
    "@kurotako/parser-openapi": "^0.2.7",
    "@kurotako/parser-prisma": "^0.2.6",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^4.1.11",
    "kurotako": "^0.2.6",
    "lefthook": "^2.1.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
